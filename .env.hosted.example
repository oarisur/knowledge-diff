GITHUB_APP_ID=123456
# Prefer base64 for multiline secrets in hosted environments:
GITHUB_PRIVATE_KEY_BASE64=BASE64_ENCODED_GITHUB_APP_PRIVATE_KEY
GITHUB_WEBHOOK_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

HOSTED_LLM_PROVIDER=openai
OPENAI_API_KEY=
# Optional providers that repositories may select in .github/knowledge-diff.yml:
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

HOST=0.0.0.0
PORT=3000
MAX_CONCURRENCY=2
MAX_QUEUE_SIZE=100
MAX_WEBHOOK_BODY_BYTES=1048576
SHUTDOWN_TIMEOUT_MS=30000

# GitHub Enterprise Server overrides:
# GITHUB_API_URL=https://github.example.com/api/v3
# GITHUB_API_VERSION=2026-03-10
