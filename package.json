{
  "name": "knowledge-diff",
  "version": "1.1.0",
  "description": "GitHub Action that detects rationale drift between code changes and project documentation.",
  "main": "dist/index.js",
  "author": "Oarisur Rahman (@oarisur)",
  "scripts": {
    "build": "npm run build:action && npm run hosted:build",
    "build:action": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "build:watch": "tsc --watch",
    "evaluate:bundle": "esbuild src/evaluation-cli.ts --bundle --platform=node --format=cjs --outfile=.evaluation-dist/evaluate.cjs --log-level=warning",
    "evaluate": "npm run evaluate:bundle --silent && node --no-deprecation .evaluation-dist/evaluate.cjs",
    "evaluate:gate": "npm run evaluate -- --gate",
    "hosted:build": "esbuild src/hosted-main.ts --bundle --platform=node --format=cjs --outfile=.hosted-dist/server.cjs --log-level=warning",
    "hosted:start": "node --no-deprecation .hosted-dist/server.cjs",
    "hosted:dev": "npm run hosted:build && npm run hosted:start",
    "test": "jest --coverage",
    "lint": "eslint \"src/**/*.ts\" \"__tests__/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "keywords": [
    "github-action",
    "documentation",
    "drift",
    "ai",
    "pull-request",
    "code-review"
  ],
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@anthropic-ai/sdk": "^0.122.0",
    "@google/genai": "^2.6.0",
    "glob": "^13.0.6",
    "minimatch": "^10.2.5",
    "openai": "^4.52.7",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/minimatch": "^5.1.2",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vercel/ncc": "^0.38.4",
    "esbuild": "^0.28.2",
    "eslint": "^10.4.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "typescript": "^5.5.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@actions/core$": "<rootDir>/node_modules/@actions/core/lib/core.js",
      "^@actions/github$": "<rootDir>/node_modules/@actions/github/lib/github.js",
      "^@actions/github/lib/utils$": "<rootDir>/node_modules/@actions/github/lib/utils.js"
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/index.ts",
      "!src/evaluation-cli.ts",
      "!src/hosted-main.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 90,
        "branches": 75,
        "functions": 90,
        "lines": 90
      }
    }
  },
  "overrides": {
    "undici": "^7.0.0"
  }
}
